# OpenRouter API Configuration
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model Configuration fallback options
MODEL_QWEN=qwen/qwen3.7-flash
MODEL_GEMINI_FLASH=google/gemini-2.5-flash-lite
MODEL_MIMO=mimo/mimo-v2.5-pro
MODEL_DEEPSEEK=deepseek/deepseek-v4-flash
MODEL_GEMINI_PRO=google/gemini-2.5-flash-lite

# Memory Configuration (CockroachDB replace)
COCKROACH_DATABASE_URL=postgresql://username:password@host:port/defaultdb?sslmode=verify-full
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_CLUSTER_ID=YOUR_COCKROACH_MCP_CLUSTER_ID


# AWS Bedrock Configuration (Hackathon reasoning model)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1

# Cost Tracking thresholds
COST_WARNING_THRESHOLD=10.0  # USD session threshold
COST_LIMIT=50.0              # USD monthly budget limit

# Security Settings
ALLOWED_FILE_TYPES=[".py",".pdf",".txt",".md",".json",".yaml",".yml"]
MAX_FILE_SIZE_MB=10
REQUIRE_PERMISSION_PROMPT=true

# Performance Settings
MAX_TOKENS_PER_REQUEST=4000
TEMPERATURE=0.7
REQUEST_TIMEOUT=30
