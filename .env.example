# CockroachSRE Environment Configuration

# Database Configuration (CockroachDB Serverless Cluster)
COCKROACH_DATABASE_URL=postgresql://username:password@host:port/defaultdb?sslmode=verify-full

# AWS Bedrock Configuration (Hackathon reasoning model)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1

# Google AI Studio Configuration (Orchestrator fallback options)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Other Direct Providers (Optional)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY

# CockroachDB MCP Integration
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_CLUSTER_ID=YOUR_COCKROACH_MCP_CLUSTER_ID

# Cost Tracking Thresholds (USD)
COST_WARNING_THRESHOLD=5.0
COST_LIMIT=20.0

# Security Settings
ALLOWED_FILE_TYPES=[".py",".pdf",".txt",".md",".json",".yaml",".yml"]
MAX_FILE_SIZE_MB=10
REQUIRE_PERMISSION_PROMPT=true

# Model Inference Configuration
MAX_TOKENS_PER_REQUEST=4000
TEMPERATURE=0.7
REQUEST_TIMEOUT=30
